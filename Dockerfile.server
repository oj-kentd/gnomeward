FROM node:24-bookworm-slim
LABEL org.opencontainers.image.title="Gnomeward multiplayer server" \
      org.opencontainers.image.source="https://github.com/oj-kentd/gnomeward" \
      org.opencontainers.image.version="0.3.4"
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=2567 DATA_DIR=/data
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY src/game.js src/data.js src/combos.js src/enemy-traits.js src/economy.js ./src/
COPY server ./server/
RUN mkdir /data && chown node:node /data
USER node
EXPOSE 2567
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/index.js"]
